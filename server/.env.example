# ===== 故事AI共创 - 环境变量模板 =====
# 复制此文件为 .env 并填入真实值

# 服务器端口
PORT=3000

# 运行环境
NODE_ENV=development

# MongoDB 连接串（暂未使用）
MONGODB_URI=mongodb://localhost:27017/story-ai

# 豆包 ARK API 密钥（文本生成）
# 获取地址：https://console.volcengine.com/ark
ARK_API_KEY=your_ark_api_key_here

# 豆包 ARK API 密钥（图片生成，可选，未设置时回退到 ARK_API_KEY）
ARK_IMAGE_API_KEY=your_ark_image_api_key_here

# DeepSeek API 密钥（备用，当前未使用）
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 豆包 TTS 语音合成 API 密钥
# 获取地址：https://console.volcengine.com/speech
TTS_API_KEY=your_tts_api_key_here

# 入口访问密码（不设置则跳过密码门）
ACCESS_PASSWORD=your_access_password_here
